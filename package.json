{
  "name": "@nulvless/cli",
  "version": "0.3.9",
  "description": "Command line interface for Nulvless",
  "type": "module",
  "license": "MIT",
  "author": "Nulvless",
  "homepage": "https://www.nulvless.com/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nulvless/cli.git"
  },
  "bugs": {
    "url": "https://github.com/nulvless/cli/issues"
  },
  "keywords": [
    "nulvless",
    "cli",
    "ai",
    "agents",
    "auth",
    "edge-functions",
    "oauth",
    "serverless"
  ],
  "bin": {
    "nulvless": "dist/index.js"
  },
  "files": [
    "dist",
    "schema",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "jest",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "@napi-rs/keyring": "^1.3.0",
    "@nulvless/nulvless-js": "^0.1.6",
    "commander": "^14.0.3",
    "jsonc-parser": "^3.3.1",
    "open": "^10.2.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "tsup": "^8.5.1",
    "typescript": "~5.9",
    "typescript-eslint": "^8.72.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
